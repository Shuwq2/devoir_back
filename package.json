{
  "name": "la-roulotte-kit",
  "version": "1.0.0",
  "private": true,
  "description": "Kit du projet La Roulotte : front fourni, simulateur de paiement, recette automatique",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "front": "node front/serve.mjs",
    "paiement": "node pay-sim/server.mjs",
    "recette:1": "node --test --test-concurrency=1 --test-reporter=spec recette/palier-1.test.mjs",
    "recette:2": "node --test --test-concurrency=1 --test-reporter=spec recette/palier-1.test.mjs recette/palier-2.test.mjs",
    "recette:3": "node --test --test-concurrency=1 --test-reporter=spec recette/palier-1.test.mjs recette/palier-2.test.mjs recette/palier-3.test.mjs",
    "recette:4": "node --test --test-concurrency=1 --test-reporter=spec recette/palier-1.test.mjs recette/palier-2.test.mjs recette/palier-3.test.mjs recette/palier-4.test.mjs"
  }
}
