generator client {
  provider = "prisma-client"
  output = "./generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

model Category {
  id       Int    @id @default(autoincrement())
  name     String @unique
  position Int
  dishes   Dish[]
}

model Dish {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  description String     @default("")
  priceCents  Int
  available   Boolean    @default(true)
  stock       Int?
  categoryId  Int
  category    Category   @relation(fields: [categoryId], references: [id])
  allergens   Allergen[]
  orderItems  OrderItem[]
}

model Allergen {
  id     Int    @id @default(autoincrement())
  code   String @unique
  label  String
  dishes Dish[]
}

model Users {
    id  Int @id @default(autoincrement())
    email String @unique
    name String 
    password String
    role String 
    orders Order[]
}

model Order {
  id         Int         @id @default(autoincrement())
  status     String      @default("RECEIVED")
  note       String?
  totalCents Int
  customerId Int
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  customer   Users       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items      OrderItem[]

  @@index([customerId, createdAt])
}

model OrderItem {
  id             Int   @id @default(autoincrement())
  orderId        Int
  dishId         Int
  name           String
  quantity       Int
  unitPriceCents Int
  lineTotalCents Int
  order          Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dish           Dish  @relation(fields: [dishId], references: [id], onDelete: Restrict)

  @@unique([orderId, dishId])
  @@index([dishId])
}